IPWEBCAM_URL=http://IP_DEL_TELEFONO:8080/shot.jpg
# Opcional: stream MJPEG nativo. Si se deja vacío se deduce de IPWEBCAM_URL.
CAMERA_STREAM_URL=
CAMERA_TIMEOUT_SECONDS=5
MAX_IMAGE_BYTES=8388608
# Solo aplica al modo de respaldo (cuadros por segundo, 1-30).
CAMERA_STREAM_FPS=10

# El backend utiliza por defecto el modelo KNN (puede leer un .joblib individual o un diccionario como modelos.joblib).
FACE_MODEL_PROVIDER=joblib
FACE_MODEL_THRESHOLD=0.0
BEST_MODEL_PATH=models/modelos.joblib
BEST_MODEL_KEY=KNN
BEST_MODEL_LABELS_PATH=models/labels.json
YUNET_PATH=models/face_detection_yunet_2023mar.onnx

# Puerto serial del ESP32. Windows: COM3/COM4; Linux: /dev/ttyUSB0.
ESP32_SERIAL_PORT=COM3
ESP32_BAUDRATE=115200
ESP32_SERIAL_TIMEOUT=1

# Opcional: integración anterior de focos/webhook de vehículos.
FOCUS_WEBHOOK_URL=
FOCUS_SERIAL_PORT=
FOCUS_SERIAL_BAUDRATE=9600
FOCUS_SERIAL_TEMPLATE=ON {plate} {owner}
